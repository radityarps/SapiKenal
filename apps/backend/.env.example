# FastAPI
FASTAPI_ENV=development
DEBUG=true

# Model (manual artifact, not committed)
# Contract: FMD, healthy, LSD, non_cattle in this exact order.
MODEL_PATH=./model/tes1_best_v3.keras
MODEL_CLASS_NAMES_PATH=./model/class_names.json
DEVICE=cpu

# History sync DB (SQLite stdlib; legacy mobile contract)
HISTORY_DB_PATH=./data/history.sqlite3

# Admin database and opaque server sessions
DATABASE_URL=sqlite:///./data/admin.sqlite3
SESSION_TTL_DAYS=7
PASSWORD_MIN_LENGTH=12
WEB_ORIGIN=http://localhost:5173
ADMIN_DEVICE_HASH_SALT=
MODEL_REGISTRY_DIR=./model/registry
MODEL_UPLOAD_MAX_BYTES=250000000
# Only use MODEL_PATH when no active registry row exists and this is explicitly enabled.
MODEL_STARTUP_FALLBACK_ENABLED=false

# One-shot admin seeder (provide through a secret manager; never commit values)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# Server
HOST=0.0.0.0
PORT=8000
# Model hot-swap requires one backend worker.
WORKERS=1
REQUEST_TIMEOUT=60

# Benchmark transport comparison (keep false outside a controlled test environment)
BENCHMARK_ENABLED=false

# Logging
LOG_LEVEL=info

# Rate limiting
RATE_LIMIT_MAX_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
