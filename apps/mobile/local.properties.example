# Mobile App Environment & Model Configuration Example
# Copy this file to local.properties (ignored by git) to configure your local build.

# API Base URL for backend connection (must start with http:// or https://)
# Emulator default: http://10.0.2.2:8000/
# Physical device default: http://192.168.x.x:8000/
API_BASE_URL=http://192.168.x.x:8000/

# Model Configuration (TFLite artifact under app/src/main/assets/)
MODEL_FILE_NAME=jenis_fp32.tflite
MODEL_VERSION=sapikenal-jenis-sapi-mobilenetv3-contract-v1-fp32
MODEL_INPUT_SIZE=224
CONFIDENCE_THRESHOLD=0.60

# Play Store release configuration. Keep passwords only in ignored
# local.properties or environment variables; never commit real values.
RELEASE_API_BASE_URL=http://192.168.x.x:8000/
VERSION_CODE=1
VERSION_NAME=0.1.0
RELEASE_STORE_FILE=upload-keystore.jks
RELEASE_STORE_PASSWORD=replace-me
RELEASE_KEY_ALIAS=upload
RELEASE_KEY_PASSWORD=replace-me
