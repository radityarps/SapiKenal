# =============================================================================
# SapiKenal Monorepo — .gitignore
# =============================================================================

# ─── OS files ─────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ─── IDEs ─────────────────────────────────────────────────────────────────────
.idea/
*.iml
*.iws
*.ipr
.vscode/
.vscode-server/
*.sublime-workspace
*.sublime-project
.kiro*/
.specs/

# ─── Temporary files ──────────────────────────────────────────────────────────
*.tmp
tmp/
*.bak
*.swp
*.swo
*~
.~*

# ─── Environment / secrets ────────────────────────────────────────────────────
.env
.env.local
.env.*.local
secrets.json
local.properties

# =============================================================================
# apps/backend (Python / FastAPI)
# =============================================================================

# Python bytecode
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Distribution / packaging
dist/
build/
*.egg-info/
.eggs/
*.egg
MANIFEST
develop-eggs/
downloads/
eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
.installed.cfg

# Test & coverage
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
coverage.xml
*.cover

# Logs
*.log
apps/backend/logs/

# Model weights — large files, share out-of-band
# apps/backend/model/*.pth
# apps/backend/model/*.pt
# apps/backend/model/*.onnx

# Dataset images & generated dataset-prep artifacts — never commit real data
apps/backend/dataset_artifacts/
dataset_artifacts/
roboflow.zip

# Model training run outputs & versioned artifact bundles (copy back deliberately)
run_out/
model_training_artifacts_*.zip

# Docker local overrides
Dockerfile.local

# =============================================================================
# apps/mobile (Android / Kotlin)
# =============================================================================

# Gradle build outputs
apps/mobile/.gradle/
apps/mobile/build/
apps/mobile/**/build/

# APK / AAB / keystore artifacts
*.apk
*.aab
*.ap_
*.dex
*.class

# Keystore — NEVER commit
*.jks
*.keystore
keystore.properties

# Android generated
apps/mobile/gen/
apps/mobile/bin/
apps/mobile/captures/
apps/mobile/lint.xml

# TFLite model inside assets — share out-of-band (optional, uncomment if large)
# apps/mobile/app/src/main/assets/*.tflite

# =============================================================================
# Go (apps/backend/go)
# =============================================================================

# Go build output
apps/backend/go/sapikenal-gateway
apps/backend/go/*.exe

# =============================================================================
# Node / frontend tooling (if added later)
# =============================================================================
node_modules/
.svelte-kit/
# Keep SvelteKit source modules under src/lib; the generic Python lib/ rule above must not hide them.
!/apps/web/src/lib/
!/apps/web/src/lib/**
package-lock.json
yarn.lock
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# =============================================================================
# Pi Coding Agent
# =============================================================================
.pi*
# Local runtime data and manual model artifacts
/data/*
!/data/.gitkeep
/apps/backend/data/*
!/apps/backend/data/.gitkeep
/apps/backend/model/*/*.keras
/apps/backend/model/*.h5
/apps/backend/model/registry/

apps/backend/sapikenal_dev.db